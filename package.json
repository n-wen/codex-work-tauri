{
  "name": "codex-work",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Codex app server desktop workbench (Tauri)",
  "scripts": {
    "postinstall": "node scripts/sync-codex-runtime.mjs",
    "predev": "node scripts/sync-codex-runtime.mjs",
    "prebuild": "node scripts/sync-codex-runtime.mjs",
    "dev": "node scripts/dev-with-log.mjs",
    "dev:tauri": "tauri dev",
    "dev:vite": "vite",
    "build": "tauri build",
